{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // UI 用例要写 `page.evaluate` 里的回调（跑在页面里），所以这一份要带 DOM 类型
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@ra2web/formats": ["./packages/formats/src/index.ts"],
      "@ra2web/assets": ["./packages/assets/src/index.ts"],
      "@ra2web/rules": ["./packages/rules/src/index.ts"],
      "@ra2web/sim": ["./packages/sim/src/index.ts"],
      "@ra2web/render": ["./packages/render/src/index.ts"],
      "@ra2web/scenarios": ["./packages/scenarios/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "tools/**/*.ts", "tests/**/*.ts"]
}
