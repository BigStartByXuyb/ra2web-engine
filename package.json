{
  "name": "ra2web-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "tsx --test \"packages/**/*.test.ts\"",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "sim:scenario": "tsx tools/sim-scenario.ts",
    "verify": "npm run typecheck && npm run test && npm run lint"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
