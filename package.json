{
  "name": "ra2web-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p tsconfig.app.json",
    "test": "tsx --test --test-concurrency=2 \"packages/**/*.test.ts\"",
    "test:ui": "tsx tests/ui/run.ts",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "app:dev": "vite --config packages/app/vite.config.ts",
    "app:build": "vite build --config packages/app/vite.config.ts",
    "game:serve": "tsx tools/serve-game.ts",
    "sim:scenario": "tsx tools/sim-scenario.ts",
    "vanilla:scene": "tsx tools/vanilla-scene.ts",
    "vanilla:mix": "tsx --test packages/formats/test/mix-encrypted.test.ts",
    "vanilla:model": "tsx tools/vanilla-model.ts",
    "vanilla:map": "tsx tools/vanilla-map.ts",
    "vanilla:tile": "tsx tools/vanilla-tile.ts",
    "verify": "npm run typecheck && npm run test && npm run lint"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.2"
  }
}
